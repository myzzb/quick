<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.xiaonuo.biz.modular.question.mapper.SgQuestionMapper">

    <select id="selectRandomList" resultType="vip.xiaonuo.biz.modular.question.entity.SgQuestion"
            parameterType="java.lang.String">
        SELECT
            *
        FROM
            sg_question
        WHERE
            DELETE_FLAG = 'NOT_DELETE'
          AND YWFL = #{ywfl}
          AND `STATUS` = '已启用'
        ORDER BY
            RAND()
            LIMIT 20
    </select>
</mapper>